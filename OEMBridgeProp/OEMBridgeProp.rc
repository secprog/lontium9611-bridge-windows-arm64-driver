#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "../Version.h"

IDD_OUTPUT_PAGE DIALOGEX 0, 0, 252, 294
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_DISABLED | WS_CAPTION
CAPTION "Output"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Output resolution:", IDC_MODE_LABEL, 7, 10, 238, 8
    COMBOBOX        IDC_MODE, 7, 22, 238, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_SINK, 7, 44, 238, 18
    LTEXT           "", IDC_ACTIVE, 7, 64, 238, 10
    LTEXT           "Auto lets the firmware drive the monitor's preferred timing, or the largest mode it advertises that the LT9611 bridge can carry (up to 3840 x 2160 at 30 Hz). The other entries are the modes read from the monitor's EDID that the bridge can drive.",
                    IDC_HELP_TEXT, 7, 86, 238, 44
    LTEXT           "The DSI link to the bridge is timed by the firmware at boot, so a change takes effect after the next restart. The resolution in Windows Settings only scales within this output mode.",
                    IDC_NOTE_TEXT, 7, 138, 238, 28
    AUTOCHECKBOX    "Enable HDMI audio",
                    IDC_AUDIO_ENABLE, 7, 176, 238, 10, BS_AUTOCHECKBOX | WS_TABSTOP
    LTEXT           "", IDC_AUDIO_STATUS, 18, 190, 227, 10
    AUTOCHECKBOX    "Enable HDMI-CEC",
                    IDC_CEC_ENABLE, 7, 210, 238, 10, BS_AUTOCHECKBOX | WS_TABSTOP
    LTEXT           "", IDC_CEC_STATUS, 18, 224, 227, 20
    LTEXT           "Logging level:", IDC_LOGGING_LABEL, 7, 252, 70, 8
    COMBOBOX        IDC_LOGGING_LEVEL, 84, 248, 161, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_LOGGING_STATUS, 18, 268, 227, 18
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    LT9611_VERSION_NUMBER
 PRODUCTVERSION LT9611_VERSION_NUMBER
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x2L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Rubik Pi 3 WoA Project"
            VALUE "FileDescription",  "LT9611 HDMI Bridge - Device Manager Output page"
            VALUE "FileVersion",      LT9611_VERSION_STRING
            VALUE "InternalName",     "OEMBridgeProp"
            VALUE "OriginalFilename", "OEMBridgeProp.dll"
            VALUE "ProductName",      "Lontium LT9611 MIPI DSI to HDMI Bridge"
            VALUE "ProductVersion",   LT9611_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

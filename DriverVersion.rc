#include <windows.h>
#include "Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION LT9611_VERSION_NUMBER
 PRODUCTVERSION LT9611_VERSION_NUMBER
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_SYSTEM
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Rubik Pi 3 WoA Project"
            VALUE "FileDescription", LT9611_FILE_DESCRIPTION
            VALUE "FileVersion", LT9611_VERSION_STRING
            VALUE "InternalName", LT9611_INTERNAL_NAME
            VALUE "OriginalFilename", LT9611_ORIGINAL_FILENAME
            VALUE "ProductName", "Lontium LT9611 MIPI DSI to HDMI Bridge"
            VALUE "ProductVersion", LT9611_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Lt9611BuildVersion Condition="'$(Lt9611BuildVersion)'==''">1.0.0.0</Lt9611BuildVersion>
    <Lt9611BuildDate Condition="'$(Lt9611BuildDate)'==''">*</Lt9611BuildDate>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <Inf>
      <SpecifyDriverVerDirectiveDate>true</SpecifyDriverVerDirectiveDate>
      <DateStamp>$(Lt9611BuildDate)</DateStamp>
      <SpecifyDriverVerDirectiveVersion>true</SpecifyDriverVerDirectiveVersion>
      <TimeStamp>$(Lt9611BuildVersion)</TimeStamp>
    </Inf>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Lt9611UseBuildVersion)'=='true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(Lt9611BuildMetadataDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>LT9611_BUILD_VERSION_GENERATED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ResourceCompile>
      <AdditionalIncludeDirectories>$(Lt9611BuildMetadataDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>LT9611_BUILD_VERSION_GENERATED=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
</Project>
